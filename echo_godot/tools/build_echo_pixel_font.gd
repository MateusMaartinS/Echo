}
const ACCENTS: Dictionary = {
    "Á":["A","00100/01000"],"À":["A","01000/00100"],"Â":["A","00100/01010"],"Ã":["A","01010/10100"],
    "É":["E","00100/01000"],"Ê":["E","00100/01010"],"Í":["I","00100/01000"],
    "Ó":["O","00100/01000"],"Ô":["O","00100/01010"],"Õ":["O","01010/10100"],
    "Ú":["U","00100/01000"],"Ü":["U","01010/00000"],"Ç":["C","00000/00000"],
}

func _initialize() -> void:
    DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://assets/fonts"))
    var characters: Array[String] = []
    for c in GLYPHS:
        characters.append(c)
    for c in ACCENTS:
        characters.append(c)
    var capitals: Array = characters.duplicate()
    for c in capitals:
        if str(c).to_lower()!=str(c):
            characters.append(str(c).to_lower())
    var image := Image.create(256,96,false,Image.FORMAT_RGBA8)
    image.fill(Color(1,1,1,0))
    var descriptor: String = 'info face="Echo Pixel" size=10 bold=0 italic=0 charset="" unicode=1 stretchH=100 smooth=0 aa=1 padding=0,0,0,0 spacing=1,0\ncommon lineHeight=12 base=9 scaleW=256 scaleH=96 pages=1 packed=0\npage id=0 file="echo_pixel.png"\nchars count=%d\n' % characters.size()
    for index in range(characters.size()):
        var c: String = characters[index]
        var upper: String = c.to_upper()
        var base: String = str(ACCENTS[upper][0]) if ACCENTS.has(upper) else upper
        var rows: PackedStringArray = str(GLYPHS[base]).split("/")
        var accent: PackedStringArray = str(ACCENTS[upper][1]).split("/") if ACCENTS.has(upper) else PackedStringArray(["00000","00000"])
        var x: int = (index%32)*8
        var y: int = int(index/32)*12
        for row in range(11):
            var bits: String = accent[row] if row<2 else (rows[row-2] if row<9 else ("00100" if row==9 else "01000") if upper=="Ç" else "00000")
            for column in range(5):
                if bits[column]=="1":
                    image.set_pixel(x+column,y+row,Color.WHITE)
        descriptor+='char id=%d x=%d y=%d width=5 height=11 xoffset=0 yoffset=0 xadvance=6 page=0 chnl=15\n' % [c.unicode_at(0),x,y]
    image.save_png("res://assets/fonts/echo_pixel.png")
    var file := FileAccess.open("res://assets/fonts/echo_pixel.fnt",FileAccess.WRITE)
    file.store_string(descriptor)
    file.close()
    print("Echo Pixel: ",characters.size()," bitmap glyphs generated")
    quit()
